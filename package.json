{
  "name": "agentlens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A flight recorder and time-travel debugger for AI agent traces — scrub through an agent run like a video, entirely in your browser.",
  "author": "Kajol Tandurkar",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sample": "node scripts/generate-sample.mjs",
    "convert": "node scripts/convert-claude-code.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
